# Carregue apenas no servidor: node --env-file=.env server/index.mjs
PORT=4173
WORLD_PROVIDER=local
# Caminho local opcional. O padrão é examples/world (somente exemplos).
# WORLD_ROOT=C:/caminho/para/conteudo
# Modo GitHub requer TODOS os campos abaixo. Não use variáveis VITE_/NEXT_PUBLIC_.
# WORLD_PROVIDER=github
# GITHUB_REPOSITORY=BispoAugusto/Contos-de-M-stica-Worldbuilding
# GITHUB_BRANCH=codex/worldbuilding-mvp
# GITHUB_CONTENT_ROOT=world
# GITHUB_TOKEN=

# Vercel: configurar no painel como variáveis de servidor. Não usar WORLD_ROOT.
# APP_ORIGIN=https://seu-dominio.vercel.app
# APP_ACCESS_KEY_SHA256=
# APP_SESSION_SECRET=
